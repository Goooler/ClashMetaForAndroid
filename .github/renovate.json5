{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>goooler/renovate-config:default.json5',
  ],
  'git-submodules': {
    enabled: true,
  },
  // Clone submodules so local Go replace directives to ./clash can be resolved during go mod tidy.
  cloneSubmodules: true,
  // Run go mod tidy on both main and foss modules in dependency order after Go dependency updates.
  postUpdateOptions: [
    'gomodTidyAll',
  ],
  packageRules: [
    {
      groupName: 'Mihomo',
      matchPackageNames: [
        'github.com/metacubex/mihomo',
        'core/src/foss/golang/clash',
        'https://github.com/MetaCubeX/mihomo',
      ],
    },
    {
      matchPackageNames: [
        'cfa',
      ],
      // Ignore internal virtual module 'cfa' from remote package lookups.
      enabled: false,
    },
  ],
}
